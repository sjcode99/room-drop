{
  "name": "roomdrop",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"node --watch server/index.js\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
